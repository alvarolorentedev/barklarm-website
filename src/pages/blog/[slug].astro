---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Site from '../../layouts/Site.astro';
import { displayDate, postPath, posts } from '../../lib/blog';

export const getStaticPaths = (async () =>
  (await posts()).map(post => ({ params: { slug: post.data.slug }, props: { post } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, authors, tags, slug } = post.data;
const url = new URL(postPath(slug), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date.toISOString(),
      mainEntityOfPage: url,
      author: { '@type': 'Person', name: authors },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Barklarm', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<Site {title} {description} {schema} article>
  <article class="reading">
    <nav class="utility-nav" aria-label="Breadcrumb"><a href="/blog">Blog</a></nav>
    <h1>{title}</h1>
    <p class="article-meta"><time datetime={date.toISOString()}>{displayDate(date)}</time> · By {authors}</p>
    <div class="prose"><Content /></div>
    <nav class="utility-nav" aria-label="Post tags">
      {tags.map(tag => <a href={`/blog/tags/${tag}`}>{tag}</a>)}
    </nav>
  </article>
</Site>
<style>
  h1 { margin-block: .35em .2em; font-size: clamp(2.45rem, 5vw, 4rem); }
  .prose { margin-block: 1.8rem; }
</style>
